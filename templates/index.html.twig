{% extends 'base.html.twig' %}

{% block description %}{{ word }}{% endblock %}

{% block ogdescription %}{{ word }}{% endblock %}

{% block ogimage %}{{ gif|giphy('giphy_s.gif') }}{% endblock %}

{% block body %}
  <h1>{{ word }}</h1>

  <picture>
    <source srcset="{{ gif|giphy('giphy.webp') }}" type="image/webp">
    <img src="{{ gif|giphy }}" alt="">
  </picture>
{% endblock %}
